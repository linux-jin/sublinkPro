所有-手动 = select,ALL_Filter
所有-自动 = url-test,ALL_Filter,url = https://www.gstatic.com/generate_204,interval = 900,tolerance = 50
AI-手动 = select,US_Filter
香港-手动 = select,HK_Filter
香港-自动 = url-test,HK_Filter,url = https://www.gstatic.com/generate_204,interval = 900,tolerance = 50
香港-故转 = fallback,香港-手动,香港-自动,url = https://www.gstatic.com/generate_204,interval = 300,max-timeout = 3000
台湾-手动 = select,TW_Filter
