[Remote Filter]
ALL_Filter = NameRegex,机场, FilterKey = "(?i)^(?!.*(?:(直连|拒绝|国内|链式)|前置)).*$"
HK_Filter = NameRegex,机场, FilterKey = "(?i)^(?=.*(广港|香港|HK|Hong[ -]?Kong|🇭🇰))(?!.*(?:(链式前置|链式)|前置)).*$"
TW_Filter = NameRegex,机场, FilterKey = "(?i)^(?=.*(广台|台湾|台灣|TW|Tai[ -]?Wan|🇹🇼))(?!.*(?:(链式前置|链式)|前置)).*$"
JP_Filter = NameRegex,机场, FilterKey = "(?i)^(?=.*(广日|日本|JP|川日|东京|大阪|泉日|埼玉|沪日|深日|🇯🇵|Japan))(?!.*(?:(链式前置|链式)|前置)).*$"
SG_Filter = NameRegex,机场, FilterKey = "(?i)^(?=.*(广新|新加坡|SG|坡|狮城|🇸🇬|Singapore))(?!.*(?:(链式前置|链式)|前置)).*$"
KR_Filter = NameRegex,机场, FilterKey = "(?i)^(?=.*(广韩|韩国|韓國|KR|首尔|春川|🇰🇷|Korea))(?!.*(?:(链式前置|链式)|前置)).*$"
PH_Filter = NameRegex,机场, FilterKey = "(?i)^(?=.*(菲律宾|菲律賓|\bPH\b|马尼拉|馬尼拉|宿务|宿霧|🇵🇭|Philippines))(?!.*(?:(链式前置|链式)|前置)).*$"
DE_Filter = NameRegex,机场, FilterKey = "(?i)^(?=.*(德国|德國|\bDE\b|法兰克福|法蘭克福|柏林|慕尼黑|🇩🇪|Germany))(?!.*(?:(链式前置|链式)|前置)).*$"
UK_Filter = NameRegex,机场, FilterKey = "(?i)^(?=.*(英国|英國|\bUK\b|\bGB\b|伦敦|倫敦|曼彻斯特|曼徹斯特|🇬🇧|United Kingdom|Britain|England))(?!.*(?:(链式前置|链式)|前置)).*$"
FR_Filter = NameRegex,机场, FilterKey = "(?i)^(?=.*(法国|法國|\bFR\b|巴黎|马赛|馬賽|里昂|🇫🇷|France))(?!.*(?:(链式前置|链式)|前置)).*$"
US_Filter = NameRegex,机场, FilterKey = "(?i)^(?=.*(广美|US|美国|纽约|波特兰|达拉斯|俄勒|凤凰城|费利蒙|洛杉|圣何塞|圣克拉|西雅|芝加|🇺🇸|United States))(?!.*(?:(链式前置|链式)|前置)).*$"
OT_Filter = NameRegex,机场, FilterKey = "(?i)^(?!.*(?:(直连|拒绝|广港|香港|HK|Hong[ -]?Kong|🇭🇰|广台|台湾|台灣|TW|Tai[ -]?Wan|🇹🇼|广日|日本|JP|川日|东京|大阪|泉日|埼玉|沪日|深日|🇯🇵|Japan|广新|新加坡|SG|坡|狮城|🇸🇬|Singapore|广韩|韩国|韓國|KR|首尔|春川|🇰🇷|Korea|菲律宾|菲律賓|\bPH\b|马尼拉|馬尼拉|宿务|宿霧|🇵🇭|Philippines|德国|德國|\bDE\b|法兰克福|法蘭克福|柏林|慕尼黑|🇩🇪|Germany|法国|法國|\bFR\b|巴黎|马赛|馬賽|里昂|🇫🇷|France|广美|US|美国|纽约|波特兰|达拉斯|俄勒|凤凰城|费利蒙|洛杉|圣何塞|圣克拉|西雅|芝加|🇺🇸|United States|国内|链式)|前置)).*$"

[Rule]
URL-REGEX,"\.log\.",REJECT
DOMAIN-KEYWORD,haijiao,美国-手动
DOMAIN,plus.younoyes.com,Media-网络
DOMAIN-SUFFIX,younoyes.com,Media-网络
FINAL,其他

